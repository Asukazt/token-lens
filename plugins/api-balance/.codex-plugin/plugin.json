{
  "name": "api-balance",
  "version": "2.1.0",
  "description": "Token Lens：在 ChatGPT 窗口内实时查看余额、逐对话 token 用量、模型与费用估算。",
  "author": {
    "name": "local"
  },
  "license": "MIT",
  "keywords": [
    "balance",
    "quota",
    "api",
    "aliyun",
    "coupon",
    "voucher",
    "widget",
    "floating-window",
    "tokens",
    "usage",
    "cost",
    "mcp"
  ],
  "mcpServers": "./.mcp.json",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "api_balance",
              "tool": "open_widget",
              "input": {}
            }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "Token Lens · 用量账本",
    "shortDescription": "余额、逐对话 token、模型与费用估算，贴在 ChatGPT 窗口内",
    "longDescription": "在 ChatGPT 窗口内实时显示余额、代金券、逐对话 token 与费用估算。费用按模型单价和分组倍率计算，支持忙闲时段，缓存命中价优先采用官网实价。小窗可最小化为金额，长按拖动，始终限制在 ChatGPT 窗口内，切出或关闭时立即隐藏。",
    "developerName": "local",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Read",
      "Write"
    ],
    "defaultPrompt": [
      "我 API 还剩多少钱？",
      "这个对话用了多少 token，花了多少？",
      "查看近 7 天各模型的用量",
      "打开用量悬浮窗设置"
    ],
    "brandColor": "#FF7557",
    "logo": "./assets/logo.png",
    "composerIcon": "./assets/logo.png",
    "screenshots": []
  }
}
